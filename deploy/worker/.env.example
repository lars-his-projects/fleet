# A fine-grained personal access token of an organization owner. Resource owner: the organization. Permission: Organization > Self-hosted runners: Read and write.
ACCESS_TOKEN=
# The GitHub organization that the runner serves.
ORG=lars-his-projects
# The name of the runner on the runner page of the organization.
RUNNER_NAME=polopc
# The labels that a job names in `runs-on` (comma-separated). GitHub adds self-hosted, Linux and X64.
LABELS=polopc
